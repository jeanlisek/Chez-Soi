# Noms de variables uniquement : aucune valeur, aucun secret dans le dépôt.
# Copier vers apps/web/.env.local (web) ou vers l'environnement du service concerné.

# H Agents API
H_API_KEY=
H_WEBHOOK_SECRET=

# Hugging Face et service vision
HF_TOKEN=
# Modèle d'explication du plan (facultatif ; défaut : openai/gpt-oss-120b via HF Inference Providers)
LLM_MODELE=
# Embeddings du graphe (facultatif ; défaut : BAAI/bge-m3 via HF Inference)
HF_EMBEDDING_URL=
# Reconnaissance d'un élément par le graphe (facultatifs ; défauts : 0.6 et 0.04)
GRAPHE_SEUIL_ELEMENT=
GRAPHE_ECART_ELEMENT=
VISION_SERVICE_URL=
# Clé partagée entre n8n et le service vision (facultative en local)
VISION_API_KEY=
# Service vision, côté Space (facultatifs) : modèle de lecture du contrat (défaut : Qwen/Qwen2.5-72B-Instruct),
# reconstruction multi-vues (1 pour l'activer), dossier des sorties (défaut : /tmp/chez-soi-vision)
CONTRAT_LLM_MODELE=
VISION_RECONSTRUCTION=
VISION_SORTIES=
# Détection sans cote (serrure, escalier, éclairage, détecteur) et vérification SigLIP : 1 par défaut, 0 pour couper
VISION_PRESENCE=
VISION_VERIFICATION=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Serveur uniquement
SUPABASE_SERVICE_ROLE_KEY=

# n8n
N8N_URL=
N8N_API_KEY=
# Valeur de l'en-tête X-Chez-Soi-Secret envoyé par l'app aux webhooks n8n (credential « Chez Soi · webhook »)
N8N_WEBHOOK_SECRET=

# PISTE (Légifrance)
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=
