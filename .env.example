# Noms de variables uniquement : aucune valeur, aucun secret dans le dépôt.
# Copier vers apps/web/.env.local (web) ou vers l'environnement du service concerné.

# H Agents API
H_API_KEY=
H_WEBHOOK_SECRET=

# Hugging Face et service vision
HF_TOKEN=
VISION_SERVICE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Serveur uniquement
SUPABASE_SERVICE_ROLE_KEY=

# n8n
N8N_URL=
N8N_API_KEY=
# Valeur de l'en-tête X-Chez-Soi-Secret envoyé par l'app aux webhooks n8n
# (la même que dans le credential n8n « Chez Soi · webhook »)
N8N_WEBHOOK_SECRET=

# PISTE (Légifrance)
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=
