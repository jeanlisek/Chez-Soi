# Secrets et environnement
.env
.env.*
!.env.example

# Node
node_modules/
.next/
out/
*.tsbuildinfo
npm-debug.log*

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Outils
.vercel/
.DS_Store
.idea/
.vscode/

# Données lourdes ou personnelles : jamais dans le dépôt
*.mp4
*.mov

# Service vision : vidéos, images extraites et résultats locaux
services/vision/donnees/
services/vision/sorties/

# Plan B du service vision : seul failles.json va au dépôt (public). Images et .glb restent en local
# et partent vers le Space privé avec deployer_space.py.
services/vision/precalcule/**/*
!services/vision/precalcule/**/
!services/vision/precalcule/**/failles.json
