{
  "name": "get_contrat",
  "description": "Renvoie uniquement les champs demandés du contrat. Jamais le PDF ni l'adresse.",
  "input_schema": {
    "type": "object",
    "properties": {
      "logement_id": { "type": "string" },
      "champs": { "type": "array", "items": { "type": "string" } }
    },
    "required": ["logement_id", "champs"],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "assureur": { "type": "string" },
      "formule": { "type": "string" },
      "reference_cg": { "type": "string" },
      "inoccupation": {
        "type": "object",
        "properties": {
          "duree_max_jours": { "type": "number" },
          "protections": { "type": "array", "items": { "type": "string" } },
          "clause": { "type": "string" },
          "page": { "type": "number" }
        },
        "required": ["duree_max_jours", "protections", "clause", "page"]
      }
    },
    "required": ["assureur", "formule"]
  }
}
